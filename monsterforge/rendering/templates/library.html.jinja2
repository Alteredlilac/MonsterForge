<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>MonsterForge — Card Library</title>
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.9.0/styles/atom-one-dark.min.css">
{% include "move_card_style.html.jinja2" %}
<style>
  /*
    NOTE:
    Same visual style as gallery.html.jinja2, deliberately duplicated
    rather than extracted into a shared partial — gallery.html.jinja2
    stays untouched on purpose, since it serves a different audience
    (the public, curated portfolio gallery) with a fixed JSON dataset
    that has no equivalent for the fields this page adds (id, revision
    count, human-review fields).
  */
  body {
    font-family: Georgia, "Times New Roman", serif;
    background: #2b2b2b;
    color: #e8ddc4;
    padding: 2rem;
  }
  .gallery-title {
    margin-bottom: 1.5rem;
    font-size: 1.2rem;
  }
  .entry-list-wrapper {
    max-width: 520px;
  }
  .entry-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .entry-list-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 8px 4px;
    border-bottom: 1px solid #555;
    cursor: pointer;
  }
  .entry-name-block {
    display: flex;
    flex-direction: column;
  }
  .entry-name {
    font-weight: bold;
    color: #e8ddc4;
  }
  .entry-list-item:hover .entry-name {
    text-decoration: underline;
  }
  .entry-id {
    color: #888;
    font-size: 0.75rem;
  }
  .entry-meta {
    color: #999;
    font-size: 0.8rem;
  }
  .modal-content {
    background: #e5e5e5;
    color: #2a2015;
  }
  .modal-title {
    color: #2a2015;
  }
  .modal-header, .nav-tabs {
    border-color: #bbb;
  }
  .tab-description {
    color: #555;
    font-size: 0.85rem;
    margin-bottom: 1rem;
  }
  /* NOTE:
     Cyan from the atom-one-dark theme already loaded on this page
     (its "literal" token color) — deliberately not green (already
     means "active", via the Bootstrap badge below) and not blue+
     underline (reads as a clickable link at a glance). Bold only, no
     background/underline. The key gets the same color, unbolded, so a
     changed line is easy to spot as a whole without drawing the eye
     away from the value itself. */
  .history-changed {
    color: #56b6c2;
    font-weight: bold;
  }
  .history-changed-key {
    color: #56b6c2;
  }
  /* The history JSON block below opts out of highlight.js (see its own
     NOTE), which also means it never gets the theme's own base
     foreground color — restore it here, or the block falls back to
     Bootstrap's default (dark) <code> color, unreadable on this dark
     background. */
  .terminal pre code.nohighlight {
    color: #abb2bf;
  }
  .terminal {
    background: #282c34;
    border-radius: 8px;
    overflow: hidden;
    margin-bottom: 1rem;
  }
  .terminal-titlebar {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 8px 10px;
    background: #21252b;
  }
  .terminal-title {
    color: #abb2bf;
    font-size: 0.8rem;
    margin-left: 6px;
  }
  /* A brighter green than the "active" badge's Bootstrap bg-success
     (#198754) — that shade reads fine on a white badge but is too
     dark to read as plain text on this near-black titlebar. */
  .terminal-title-active {
    color: #3ddc84;
  }
  .terminal-titlebar .dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    display: inline-block;
  }
  .dot-red { background: #ff5f56; }
  .dot-yellow { background: #ffbd2e; }
  .dot-green { background: #27c93f; }
  .terminal pre {
    margin: 0;
    padding: 1rem;
    background: transparent;
    white-space: pre-wrap;
    word-break: break-word;
    font-family: "Fira Code", Consolas, Monaco, monospace;
    font-size: 0.8rem;
  }
  .terminal pre code.hljs {
    background: transparent;
    padding: 0;
    white-space: pre-wrap;
    word-break: break-word;
  }
  .nav-tabs .nav-link {
    color: #555;
  }
  .nav-tabs .nav-link.active {
    background: #fdfcf8;
    color: #2a2015;
    border-color: #bbb #bbb #fdfcf8;
  }
  .modal-card-wrapper {
    display: flex;
    justify-content: center;
    padding: 1rem 0;
  }
  .modal-body {
    overflow-y: auto;
  }
</style>
</head>
<body>
{% macro terminal(content) %}
<div class="terminal">
  <div class="terminal-titlebar">
    <span class="dot dot-red"></span>
    <span class="dot dot-yellow"></span>
    <span class="dot dot-green"></span>
  </div>
  <pre><code class="language-json">{{ content }}</code></pre>
</div>
{% endmacro %}
{% macro history_json(entry) %}
<!--
  NOTE:
  class="nohighlight", not "language-json" like terminal() above — this
  block embeds a real <span> around whichever value changed, and
  hljs.highlightAll() (called once for every ".language-json" block on
  the page, further down) re-tokenizes raw text and would treat that
  <span> as literal characters to escape, destroying the highlight.
  "nohighlight" is highlight.js's own documented way to exclude a block
  from that pass.

  The event's header (type/decision/actor/when) lives in this same
  terminal's titlebar, not a separate paragraph above it — one framed
  block per event, not two, so header and detail read as one thing.
-->
<div class="terminal">
  <div class="terminal-titlebar">
    <span class="dot dot-red"></span>
    <span class="dot dot-yellow"></span>
    <span class="dot dot-green"></span>
    {% if entry.is_active %}<span class="badge bg-success">active</span>{% endif %}
    <span class="terminal-title{{ ' terminal-title-active' if entry.is_active }}">{{ entry.event_type }} — {{ entry.decision }} — {{ entry.actor_name }} (authority {{ entry.actor_authority }}) — {{ entry.created_at }}</span>
    {% if entry.decision != "rejected" %}
    <a href="/library/events/{{ entry.id }}/review" class="btn btn-outline-secondary btn-sm ms-auto">Reopen for review</a>
    {% endif %}
  </div>
  <pre><code class="nohighlight">{
{% for field in entry.fields -%}
  <span class="{{ 'history-changed-key' if field.changed }}">"{{ field.key }}"</span>: <span class="{{ 'history-changed' if field.changed }}">{{ field.value_json }}</span>{{ "," if not loop.last }}
{% endfor -%}
}</code></pre>
</div>
{% endmacro %}
<div class="d-flex justify-content-between align-items-center mb-3">
  <a href="/convert" class="btn btn-outline-secondary btn-sm">Home</a>
  <form method="get" action="/library/cards" class="d-flex" style="max-width: 360px;">
    <input type="text" name="q" value="{{ query }}" class="form-control form-control-sm me-2"
           placeholder="Search by name or id">
    <button type="submit" class="btn btn-outline-secondary btn-sm">Search</button>
    {% if query %}
    <a href="/library/cards" class="btn btn-outline-secondary btn-sm ms-2">Clear</a>
    {% endif %}
  </form>
</div>
<h1 class="gallery-title">MonsterForge — {{ entries|length }} Cards in the Library</h1>
{% if query and not entries %}
<p class="text-muted">No cards match "{{ query }}".</p>
{% endif %}
<div class="entry-list-wrapper">
  <ul class="entry-list">
    {% for entry in entries %}
    <li class="entry-list-item" data-bs-toggle="modal" data-bs-target="#cardModal-{{ entry.index }}">
      <span class="entry-name-block">
        <span class="entry-name">{{ entry.name }}</span>
        <span class="entry-id">ID {{ entry.short_id }} · {{ entry.revision_count }} revision{{ "s" if entry.revision_count != 1 else "" }}</span>
      </span>
      <span class="entry-meta">
        {% if entry.has_card %}{{ entry.move_type }} / {{ entry.category }}{% else %}<span class="text-danger">rejected</span>{% endif %}
      </span>
    </li>
    {% endfor %}
  </ul>
</div>

{% for entry in entries %}
<div class="modal fade" id="cardModal-{{ entry.index }}" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-fullscreen">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">{{ entry.name }}</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        {% if not entry.has_card %}
        <div class="alert alert-warning">This attack's active attempt was rejected — no card was produced. See History for what happened and to reopen an earlier attempt.</div>
        {% endif %}
        <ul class="nav nav-tabs" role="tablist">
          <li class="nav-item">
            <button class="nav-link active" data-bs-toggle="tab" data-bs-target="#raw-{{ entry.index }}" type="button">Raw Input</button>
          </li>
          {% if entry.has_card %}
          <li class="nav-item">
            <button class="nav-link" data-bs-toggle="tab" data-bs-target="#classification-{{ entry.index }}" type="button">Classification</button>
          </li>
          <li class="nav-item">
            <button class="nav-link" data-bs-toggle="tab" data-bs-target="#json-{{ entry.index }}" type="button">JSON</button>
          </li>
          <li class="nav-item">
            <button class="nav-link card-tab-trigger" data-bs-toggle="tab" data-bs-target="#card-{{ entry.index }}" type="button">Card</button>
          </li>
          {% endif %}
          <li class="nav-item">
            <button class="nav-link" data-bs-toggle="tab" data-bs-target="#history-{{ entry.index }}" type="button">History</button>
          </li>
        </ul>
        <div class="tab-content pt-3">
          <div class="tab-pane fade show active" id="raw-{{ entry.index }}">
            <p class="tab-description">The <strong>raw</strong> D&amp;D 3.x attack notation and optional creature context, exactly as submitted through the web form.</p>
            {{ terminal(entry.raw_input_json) }}
            {{ terminal(entry.context_json) }}
          </div>
          {% if entry.has_card %}
          <div class="tab-pane fade" id="classification-{{ entry.index }}">
            <p class="tab-description">The <strong>currently active</strong> classification for this attack: what the LLM decided, its own confidence/rationale, and — when this result went through review — the human reviewer's score/note.</p>
            {{ terminal(entry.classification_values_json) }}
            {{ terminal(entry.classification_confidence_json) }}
            {% if entry.human_review_json %}
            {{ terminal(entry.human_review_json) }}
            {% endif %}
          </div>
          <div class="tab-pane fade" id="json-{{ entry.index }}">
            <p class="tab-description">The final MoveCard <strong>domain object</strong>, serialized to JSON — the same shape the pipeline would return via an API.</p>
            {{ terminal(entry.move_card_json) }}
          </div>
          <div class="tab-pane fade" id="card-{{ entry.index }}">
            <p class="tab-description"><strong>FINAL RENDERED CARD</strong> — the currently saved card for this attack, exactly as stored.</p>
            <div class="modal-card-wrapper">
              {{ entry.card_html | safe }}
            </div>
            <div class="text-center mt-3">
              <a href="/library/cards/{{ entry.raw_field_id }}" class="btn btn-outline-secondary">Open for Print / Review</a>
            </div>
          </div>
          {% endif %}
          <div class="tab-pane fade" id="history-{{ entry.index }}">
            <p class="tab-description">Every LLM run and human decision recorded for this attack, oldest first — not just the currently active result.</p>
            {% for event in entry.history %}
            {{ history_json(event) }}
            {% endfor %}
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
{% endfor %}

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.9.0/highlight.min.js"></script>
<script>
  hljs.highlightAll();
</script>
<script>
  // Same fit-to-viewport zoom and modal-tab-reset behavior as
  // gallery.html.jinja2 — see that template's own comments for why.
  document.querySelectorAll(".card-tab-trigger").forEach(function (trigger) {
    trigger.addEventListener("shown.bs.tab", function (event) {
      var pane = document.querySelector(event.target.getAttribute("data-bs-target"));
      var wrapper = pane ? pane.querySelector(".modal-card-wrapper") : null;
      var modalEl = trigger.closest(".modal");
      var body = modalEl ? modalEl.querySelector(".modal-body") : null;
      var navTabs = modalEl ? modalEl.querySelector(".nav-tabs") : null;
      if (!wrapper || !body) return;

      wrapper.style.zoom = 1;
      var cardHeight = wrapper.scrollHeight;
      var navTabsHeight = navTabs ? navTabs.offsetHeight : 0;
      var available = body.clientHeight - navTabsHeight - 32;
      var scale = Math.min(1, available / cardHeight);
      wrapper.style.zoom = scale > 0 ? scale : 1;
    });
  });

  document.querySelectorAll(".modal").forEach(function (modalEl) {
    modalEl.addEventListener("hidden.bs.modal", function () {
      var firstTabTrigger = modalEl.querySelector(".nav-tabs .nav-link");
      if (firstTabTrigger) {
        bootstrap.Tab.getOrCreateInstance(firstTabTrigger).show();
      }
    });
  });
</script>
</body>
</html>
