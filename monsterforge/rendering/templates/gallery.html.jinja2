<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>MonsterForge — MoveCard Gallery</title>
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.9.0/styles/atom-one-dark.min.css">
{% include "move_card_style.html.jinja2" %}
<style>
  /*
    NOTE:
    Page background/list colors intentionally match
    entrypoints/output/rendered_cards/index.html's dark theme (the QA
    tool's own index page) — this main page is now the same kind of
    plain clickable list, left-aligned rather than centered, same as
    that reference page. The modals keep their own separate light theme
    unchanged (they already worked and weren't part of this ask).
  */
  body {
    font-family: Georgia, "Times New Roman", serif;
    background: #2b2b2b;
    color: #e8ddc4;
    padding: 2rem;
  }
  .gallery-title {
    margin-bottom: 1.5rem;
    font-size: 1.2rem;
  }
  .entry-list-wrapper {
    max-width: 520px;
  }
  .entry-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .entry-list-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 8px 4px;
    border-bottom: 1px solid #555;
    cursor: pointer;
  }
  .entry-name {
    font-weight: bold;
    color: #e8ddc4;
  }
  .entry-list-item:hover .entry-name {
    text-decoration: underline;
  }
  .entry-meta {
    color: #999;
    font-size: 0.8rem;
  }
  .modal-content {
    background: #e5e5e5;
    color: #2a2015;
  }
  .modal-title {
    color: #2a2015;
  }
  .modal-header, .nav-tabs {
    border-color: #bbb;
  }
  .tab-description {
    color: #555;
    font-size: 0.85rem;
    margin-bottom: 1rem;
  }
  .terminal {
    background: #282c34;
    border-radius: 8px;
    overflow: hidden;
    margin-bottom: 1rem;
  }
  .terminal-titlebar {
    display: flex;
    gap: 6px;
    padding: 8px 10px;
    background: #21252b;
  }
  .terminal-titlebar .dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    display: inline-block;
  }
  .dot-red { background: #ff5f56; }
  .dot-yellow { background: #ffbd2e; }
  .dot-green { background: #27c93f; }
  .terminal pre {
    margin: 0;
    padding: 1rem;
    background: transparent;
    white-space: pre-wrap;
    word-break: break-word;
    font-family: "Fira Code", Consolas, Monaco, monospace;
    font-size: 0.8rem;
  }
  .terminal pre code.hljs {
    background: transparent;
    padding: 0;
    white-space: pre-wrap;
    word-break: break-word;
  }
  .nav-tabs .nav-link {
    color: #555;
  }
  .nav-tabs .nav-link.active {
    background: #fdfcf8;
    color: #2a2015;
    border-color: #bbb #bbb #fdfcf8;
  }
  .modal-card-wrapper {
    display: flex;
    justify-content: center;
    padding: 1rem 0;
  }
  .modal-body {
    overflow-y: auto;
  }
</style>
</head>
<body>
{% macro terminal(content) %}
<div class="terminal">
  <div class="terminal-titlebar">
    <span class="dot dot-red"></span>
    <span class="dot dot-yellow"></span>
    <span class="dot dot-green"></span>
  </div>
  <pre><code class="language-json">{{ content }}</code></pre>
</div>
{% endmacro %}
<h1 class="gallery-title">MonsterForge — {{ entries|length }} MoveCards from the real pipeline</h1>
<div class="entry-list-wrapper">
  <ul class="entry-list">
    {% for entry in entries %}
    <li class="entry-list-item" data-bs-toggle="modal" data-bs-target="#cardModal-{{ entry.index }}">
      <span class="entry-name">{{ entry.name }}</span>
      <span class="entry-meta">{{ entry.move_type }} / {{ entry.category }}</span>
    </li>
    {% endfor %}
  </ul>
</div>

{% for entry in entries %}
<div class="modal fade" id="cardModal-{{ entry.index }}" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-fullscreen">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">{{ entry.name }}</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <ul class="nav nav-tabs" role="tablist">
          <li class="nav-item">
            <button class="nav-link active" data-bs-toggle="tab" data-bs-target="#raw-{{ entry.index }}" type="button">Raw Input</button>
          </li>
          <li class="nav-item">
            <button class="nav-link" data-bs-toggle="tab" data-bs-target="#classification-{{ entry.index }}" type="button">Classification</button>
          </li>
          <li class="nav-item">
            <button class="nav-link" data-bs-toggle="tab" data-bs-target="#json-{{ entry.index }}" type="button">JSON</button>
          </li>
          <li class="nav-item">
            <button class="nav-link card-tab-trigger" data-bs-toggle="tab" data-bs-target="#card-{{ entry.index }}" type="button">Card</button>
          </li>
        </ul>
        <div class="tab-content pt-3">
          <div class="tab-pane fade show active" id="raw-{{ entry.index }}">
            <p class="tab-description">The <strong>raw</strong> D&amp;D 3.x attack notation and optional creature context, exactly as entered or scraped from a stat block — <strong>before any interpretation</strong>.</p>
            {{ terminal(entry.raw_input_json) }}
            {{ terminal(entry.context_json) }}
          </div>
          <div class="tab-pane fade" id="classification-{{ entry.index }}">
            <p class="tab-description">The <strong>semantic classification</strong> step: an LLM reads the raw attack and free-text context to infer what a fixed-format parser can't (move type, description, range), together with its self-reported confidence and rationale.</p>
            {{ terminal(entry.raw_response) }}
          </div>
          <div class="tab-pane fade" id="json-{{ entry.index }}">
            <p class="tab-description">The final MoveCard <strong>domain object</strong>, serialized to JSON — the same shape the pipeline would return via an API.</p>
            {{ terminal(entry.move_card_json) }}
          </div>
          <div class="tab-pane fade" id="card-{{ entry.index }}">
            <p class="tab-description"><strong>FINAL RENDERED CARD</strong> — the same MoveCard produced by the full pipeline (raw input → semantic classification → domain conversion), shown here as the printable HTML/CSS card.</p>
            <div class="modal-card-wrapper">
              {{ entry.card_html | safe }}
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
{% endfor %}

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.9.0/highlight.min.js"></script>
<script>
  // raw_response isn't guaranteed to be valid JSON (it's the LLM's raw
  // text reply, shown as-is for transparency) — highlightAll() tokenizes
  // it on a best-effort basis regardless, same as it would for any
  // near-JSON text.
  hljs.highlightAll();
</script>
<script>
  // A card's rendered height varies with its content (description
  // length, bonus cards present) and available viewport height varies
  // per screen, so a single fixed zoom factor either wastes space on
  // tall screens or still requires scrolling on short ones. Instead,
  // compute the exact zoom needed to fit the card into the space
  // actually available.
  //
  // Listens on the Card tab trigger's "shown.bs.tab" event, not the
  // modal's "shown.bs.modal": the modal now opens on Raw Input by
  // default, so the Card tab-pane (and .modal-card-wrapper inside it)
  // is still display:none at modal-open time and would measure 0.
  // Recomputing per tab-shown also means switching away and back still
  // gets a correct measurement, not just the first time.
  document.querySelectorAll(".card-tab-trigger").forEach(function (trigger) {
    trigger.addEventListener("shown.bs.tab", function (event) {
      var pane = document.querySelector(event.target.getAttribute("data-bs-target"));
      var wrapper = pane ? pane.querySelector(".modal-card-wrapper") : null;
      var modalEl = trigger.closest(".modal");
      var body = modalEl ? modalEl.querySelector(".modal-body") : null;
      var navTabs = modalEl ? modalEl.querySelector(".nav-tabs") : null;
      if (!wrapper || !body) return;

      wrapper.style.zoom = 1;
      var cardHeight = wrapper.scrollHeight;
      var navTabsHeight = navTabs ? navTabs.offsetHeight : 0;
      var available = body.clientHeight - navTabsHeight - 32;
      var scale = Math.min(1, available / cardHeight);
      wrapper.style.zoom = scale > 0 ? scale : 1;
    });
  });

  // Reset each modal to its default tab (Raw Input, the first nav-link)
  // on close — Bootstrap doesn't tear down tab state when a modal is
  // hidden, so without this, reopening the same card's modal resumed on
  // whatever tab was last viewed instead of starting fresh.
  document.querySelectorAll(".modal").forEach(function (modalEl) {
    modalEl.addEventListener("hidden.bs.modal", function () {
      var firstTabTrigger = modalEl.querySelector(".nav-tabs .nav-link");
      if (firstTabTrigger) {
        bootstrap.Tab.getOrCreateInstance(firstTabTrigger).show();
      }
    });
  });
</script>
</body>
</html>
