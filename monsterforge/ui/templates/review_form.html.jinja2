<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>Review Classification — MonsterForge</title>
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light">
<div class="container py-5" style="max-width: 640px;">
  <h1 class="mb-4">Human Review Requested</h1>

  {% if error_message %}
  <div class="alert alert-warning" role="alert">{{ error_message }}</div>
  {% endif %}

  <div class="card mb-4">
    <div class="card-body">
      <h2 class="h6">Raw attack</h2>
      <p class="mb-1"><strong>Name:</strong> {{ raw_attack.name }}</p>
      <p class="mb-1"><strong>Modifier:</strong> {{ raw_attack.modifier }}</p>
      <p class="mb-1"><strong>Attack type:</strong> {{ raw_attack.attack_type }}</p>
      <p class="mb-3"><strong>Attack effect:</strong> {{ raw_attack.attack_effect }}</p>

      <h2 class="h6">Context</h2>
      <p class="mb-1"><strong>Additional description:</strong> {{ semantic_context.additional_description or "—" }}</p>
      <p class="mb-1"><strong>Creature description:</strong> {{ semantic_context.creature_description or "—" }}</p>
      <p class="mb-3"><strong>Creature subtype:</strong> {{ semantic_context.creature_subtype or "—" }}</p>

      <h2 class="h6">Template</h2>
      <p class="mb-3"><code>{{ template_name }}</code></p>

      <h2 class="h6">Classification</h2>
      <p class="mb-1"><strong>Confidence:</strong> {{ "%.2f"|format(semantic_result.confidence) }}</p>
      <p class="mb-0"><strong>Rationale:</strong> {{ semantic_result.rationale }}</p>
    </div>
  </div>

  <form method="post" action="/review">
    <input type="hidden" name="raw_attack_name" value="{{ raw_attack.name }}">
    <input type="hidden" name="raw_attack_modifier" value="{{ raw_attack.modifier }}">
    <input type="hidden" name="raw_attack_attack_type" value="{{ raw_attack.attack_type }}">
    <input type="hidden" name="raw_attack_attack_effect" value="{{ raw_attack.attack_effect }}">
    <input type="hidden" name="additional_description" value="{{ semantic_context.additional_description or '' }}">
    <input type="hidden" name="creature_description" value="{{ semantic_context.creature_description or '' }}">
    <input type="hidden" name="creature_subtype" value="{{ semantic_context.creature_subtype.value if semantic_context.creature_subtype else '' }}">
    <input type="hidden" name="template_name" value="{{ template_name }}">
    <input type="hidden" name="image_uri" value="{{ image_uri }}">
    <input type="hidden" name="semantic_result_json" value='{{ semantic_result_json }}'>

    <fieldset class="mb-4">
      <legend class="h5">Correction (used only if you click "Correct")</legend>
      <div class="mb-3">
        <label for="name" class="form-label">Name</label>
        <input type="text" class="form-control" id="name" name="name" value="{{ raw_attack.name }}" required>
      </div>
      <div class="mb-3">
        <label for="description" class="form-label">Description</label>
        <textarea class="form-control" id="description" name="description" rows="2">{{ semantic_result.description }}</textarea>
      </div>
      <div class="mb-3">
        <label for="move_type" class="form-label">Move type</label>
        <select class="form-select" id="move_type" name="move_type">
          {% for value in move_types %}
          <option value="{{ value }}" {{ "selected" if value == semantic_result.move_type else "" }}>{{ value }}</option>
          {% endfor %}
        </select>
      </div>
      {% if not is_melee %}
      <div class="row">
        <div class="col mb-3">
          <label for="range_value" class="form-label">Range value</label>
          <input type="number" min="1" class="form-control" id="range_value" name="range_value"
                 value="{{ semantic_result.move_range.effect_range if semantic_result.move_range else '' }}">
        </div>
        <div class="col mb-3">
          <label for="range_unit" class="form-label">Range unit</label>
          <select class="form-select" id="range_unit" name="range_unit">
            {% for value in unit_systems %}
            <option value="{{ value }}" {{ "selected" if semantic_result.move_range and value == semantic_result.move_range.range_unit_system else "" }}>{{ value }}</option>
            {% endfor %}
          </select>
        </div>
      </div>
      {% endif %}
    </fieldset>

    <fieldset class="mb-4">
      <legend class="h5">Reviewer notes (optional, recorded for any decision)</legend>
      <div class="mb-3">
        <label for="assigned_llm_score" class="form-label">Score for this classification</label>
        <input type="number" step="0.01" min="0" max="1" class="form-control" id="assigned_llm_score" name="assigned_llm_score">
      </div>
      <div class="mb-3">
        <label for="edit_note" class="form-label">Note</label>
        <textarea class="form-control" id="edit_note" name="edit_note" rows="2"></textarea>
      </div>
    </fieldset>

    <fieldset class="mb-4">
      <legend class="h5">Rerun (used only if you click "Rerun")</legend>
      <div class="mb-3">
        <label for="rerun_note" class="form-label">Note, appended to Additional description</label>
        <textarea class="form-control" id="rerun_note" name="rerun_note" rows="2"></textarea>
      </div>
      <div class="mb-3">
        <label for="rerun_template_name" class="form-label">Prompt template for rerun</label>
        <select class="form-select" id="rerun_template_name" name="rerun_template_name">
          {% for option in prompt_templates %}
          <option value="{{ option.path }}" {{ "selected" if option.path == template_name else "" }}>{{ option.label }}</option>
          {% endfor %}
        </select>
      </div>
    </fieldset>

    <!--
      formnovalidate on Approve/Reject/Rerun: the correction fieldset
      above (name/description/move_type/range) is used only if Correct
      is clicked — HTML5 required on the name field must not block the
      other three decisions just because a field they ignore is blank.
    -->
    <button type="submit" name="decision" value="approve" class="btn btn-success me-2" formnovalidate>Approve</button>
    <button type="submit" name="decision" value="correct" class="btn btn-primary me-2">Correct</button>
    <button type="submit" name="decision" value="reject" class="btn btn-danger me-2" formnovalidate>Reject</button>
    <button type="submit" name="decision" value="rerun" class="btn btn-secondary" formnovalidate>Rerun</button>
  </form>
</div>
</body>
</html>
