<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>Convert Attack — MonsterForge</title>
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light">
<div class="container py-5" style="max-width: 640px;">
  <h1 class="mb-4">Convert a D&amp;D 3.x Attack</h1>
  <form method="post" action="/convert">
    <fieldset class="mb-4">
      <legend class="h5">Raw attack</legend>
      <div class="mb-3">
        <label for="name" class="form-label">Name</label>
        <input type="text" class="form-control" id="name" name="name">
      </div>
      <div class="mb-3">
        <label for="modifier" class="form-label">Attack modifier</label>
        <input type="text" class="form-control" id="modifier" name="modifier" placeholder="e.g. +7">
      </div>
      <div class="mb-3">
        <label for="attack_type" class="form-label">Attack type</label>
        <input type="text" class="form-control" id="attack_type" name="attack_type" placeholder="e.g. melee">
      </div>
      <div class="mb-3">
        <label for="attack_effect" class="form-label">Attack effect</label>
        <input type="text" class="form-control" id="attack_effect" name="attack_effect" placeholder="e.g. 1d6+3 plus trip">
      </div>
    </fieldset>

    <fieldset class="mb-4">
      <legend class="h5">Optional context</legend>
      <div class="mb-3">
        <label for="additional_description" class="form-label">Additional description</label>
        <textarea class="form-control" id="additional_description" name="additional_description" rows="2"></textarea>
      </div>
      <div class="mb-3">
        <label for="creature_description" class="form-label">Creature description</label>
        <textarea class="form-control" id="creature_description" name="creature_description" rows="2"></textarea>
      </div>
      <div class="mb-3">
        <label for="creature_subtype" class="form-label">Creature subtype</label>
        <select class="form-select" id="creature_subtype" name="creature_subtype">
          <option value="">(none)</option>
          {% for subtype in creature_subtypes %}
          <option value="{{ subtype }}">{{ subtype }}</option>
          {% endfor %}
        </select>
      </div>
    </fieldset>

    <button type="submit" class="btn btn-primary">Convert</button>
  </form>
</div>
</body>
</html>
