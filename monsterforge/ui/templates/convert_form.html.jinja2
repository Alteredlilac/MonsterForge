<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>Convert Attack — MonsterForge</title>
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
<style>
  /* Draws attention to Auto-fill for a first-time visitor: a soft
     amber ring (matching btn-warning's own color) that expands and
     fades on a loop. Pure CSS, no JS -- box-shadow animates for free,
     unlike width/height, without triggering layout reflow. */
  @keyframes pulse-glow {
    0% { box-shadow: 0 0 0 0 rgba(255, 193, 7, 0.6); }
    70% { box-shadow: 0 0 0 14px rgba(255, 193, 7, 0); }
    100% { box-shadow: 0 0 0 0 rgba(255, 193, 7, 0); }
  }
  #auto_fill_button {
    animation: pulse-glow 2s infinite;
  }

  /* Same effect on Convert, in its own btn-primary blue -- draws the
     eye to the actual submit action the same way Auto-fill draws it to
     the shortcut. */
  @keyframes pulse-glow-primary {
    0% { box-shadow: 0 0 0 0 rgba(13, 110, 253, 0.6); }
    70% { box-shadow: 0 0 0 14px rgba(13, 110, 253, 0); }
    100% { box-shadow: 0 0 0 0 rgba(13, 110, 253, 0); }
  }
  #convert_button {
    animation: pulse-glow-primary 2s infinite;
  }
</style>
</head>
<body class="bg-light">
<div class="container py-5" style="max-width: 640px;">
  <h1 class="mb-3">Convert a D&amp;D 3.x Attack</h1>
  <div class="d-flex align-items-center mb-4">
    <span class="text-muted small me-2">Auto-fill fills every field with a random example attack.</span>
    <button type="button" class="btn btn-warning" id="auto_fill_button">Auto-fill</button>
  </div>
  <form method="post" action="/convert" id="convert_form">
    <fieldset class="mb-4">
      <legend class="h5">Raw attack</legend>
      <div class="mb-3">
        <label for="name" class="form-label">Name</label>
        <input type="text" class="form-control" id="name" name="name" required>
      </div>
      <div class="row">
        <div class="col mb-3">
          <label for="modifier" class="form-label">Attack modifier</label>
          <input type="text" class="form-control" id="modifier" name="modifier" placeholder="e.g. +7">
        </div>
        <div class="col mb-3">
          <label for="attack_type" class="form-label">Attack type</label>
          <select class="form-select" id="attack_type" name="attack_type" required>
            <option value="" disabled selected>-- select --</option>
            {% for value in attack_types %}
            <option value="{{ value }}">{{ value }}</option>
            {% endfor %}
          </select>
        </div>
      </div>
      <div class="mb-3">
        <label for="attack_effect" class="form-label">Attack effect</label>
        <input type="text" class="form-control" id="attack_effect" name="attack_effect" placeholder="e.g. 1d6+3 plus trip">
      </div>
      <div class="row">
        <div class="col mb-3">
          <label for="range_value" class="form-label">Range value</label>
          <input type="number" min="1" class="form-control" id="range_value" name="range_value">
        </div>
        <div class="col mb-3">
          <label for="range_unit" class="form-label">Range unit</label>
          <select class="form-select" id="range_unit" name="range_unit">
            <option value="">-- select --</option>
            {% for value in unit_systems %}
            <option value="{{ value }}">{{ value }}</option>
            {% endfor %}
          </select>
        </div>
      </div>
      <div class="form-text mb-3">
        Only needed for a ranged/ranged touch attack whose range isn't already stated in
        "Additional description" below — melee attacks disable these, and any range already
        described in prose is left to the classifier.
      </div>
    </fieldset>

    <fieldset class="mb-4">
      <legend class="h5">Optional context</legend>
      <div class="mb-3">
        <label for="additional_description" class="form-label">Additional description</label>
        <textarea class="form-control" id="additional_description" name="additional_description" rows="2"></textarea>
      </div>
      <div class="mb-3">
        <label for="creature_description" class="form-label">Creature description</label>
        <textarea class="form-control" id="creature_description" name="creature_description" rows="2"></textarea>
      </div>
      <div class="mb-3">
        <label for="image_uri" class="form-label">Image URL (optional)</label>
        <input type="url" class="form-control" id="image_uri" name="image_uri" placeholder="https://...">
        <div class="form-text">Web URLs only — a local file path won't load from this page.</div>
      </div>
      <div class="mb-3">
        <label for="creature_subtype" class="form-label">Creature subtype</label>
        <select class="form-select" id="creature_subtype" name="creature_subtype">
          <option value="">(none)</option>
          {% for subtype in creature_subtypes %}
          <option value="{{ subtype }}">{{ subtype }}</option>
          {% endfor %}
        </select>
      </div>
      <div class="form-check mb-3">
        <input type="checkbox" class="form-check-input" id="force_review" name="force_review" value="true">
        <label class="form-check-label" for="force_review">
          Always review, regardless of confidence
        </label>
      </div>
    </fieldset>

    <fieldset class="mb-4">
      <legend class="h5">Classification prompt</legend>
      <div class="mb-3">
        <label for="template_name" class="form-label">Prompt template</label>
        <select class="form-select" id="template_name" name="template_name">
          {% for option in prompt_templates %}
          <option value="{{ option.path }}" data-description="{{ option.description }}">{{ option.label }}</option>
          {% endfor %}
        </select>
        <div class="form-text" id="template_description"></div>
      </div>
    </fieldset>

    <div class="d-flex justify-content-between">
      <button type="submit" class="btn btn-primary btn-lg" id="convert_button">Convert</button>
      <button type="button" class="btn btn-danger" id="clear_form_button">Clear Form</button>
    </div>
  </form>
</div>
<script>
  // NOTE:
  // Range value/unit are required only for a ranged/ranged touch attack
  // with no additional_description at all — most ranged attacks already
  // resolve their range from prose context (e.g. real SRD text), so this
  // is a last-resort requirement, not a blanket one. Melee/melee touch
  // attacks disable these fields entirely, since get_known_attack_range()
  // ignores any range for a melee attack regardless of what's supplied.
  var attackType = document.getElementById("attack_type");
  var additionalDescription = document.getElementById("additional_description");
  var rangeValue = document.getElementById("range_value");
  var rangeUnit = document.getElementById("range_unit");

  function updateRangeFields() {
    var isMelee = attackType.value === "melee" || attackType.value === "melee touch";
    var isRanged = attackType.value === "ranged" || attackType.value === "ranged touch";
    var hasDescription = additionalDescription.value.trim().length > 0;

    rangeValue.disabled = isMelee;
    rangeUnit.disabled = isMelee;

    if (isMelee) {
      rangeValue.required = false;
      rangeUnit.required = false;
      rangeValue.value = "";
    } else {
      var required = isRanged && !hasDescription;
      rangeValue.required = required;
      rangeUnit.required = required;
    }
  }

  attackType.addEventListener("change", updateRangeFields);
  additionalDescription.addEventListener("input", updateRangeFields);
  updateRangeFields();

  // Shows the selected prompt template's description below the dropdown —
  // stored per <option> as data-description rather than a separate lookup
  // table in JS, so the two can never drift apart.
  var templateSelect = document.getElementById("template_name");
  var templateDescription = document.getElementById("template_description");

  function updateTemplateDescription() {
    templateDescription.textContent = templateSelect.selectedOptions[0].dataset.description;
  }

  templateSelect.addEventListener("change", updateTemplateDescription);
  updateTemplateDescription();

  // Auto-fill: picks one random sample and sets each field whose id
  // matches a key in the sample object directly (image_uri/force_review/
  // template_name are deliberately absent from every sample, so they're
  // left untouched). Fields with their own change/input listeners above
  // (attack_type, additional_description) need those events fired
  // explicitly -- setting .value alone doesn't trigger them, so
  // updateRangeFields() would otherwise never re-run against the new
  // values.
  var sampleAttacks = {{ sample_attacks | tojson }};

  document.getElementById("auto_fill_button").addEventListener("click", function () {
    var sample = sampleAttacks[Math.floor(Math.random() * sampleAttacks.length)];
    for (var key in sample) {
      var field = document.getElementById(key);
      if (field) {
        field.value = sample[key];
      }
    }
    attackType.dispatchEvent(new Event("change"));
    additionalDescription.dispatchEvent(new Event("input"));
  });

  // Clear Form: native form.reset() correctly restores every field
  // (including <select>/checkbox) to its rendered default -- simpler
  // and more robust than clearing each field by hand. Same gotcha as
  // Auto-fill applies afterward: the range-field and template-
  // description logic above only reacts to change/input events on the
  // fields it watches, neither of which form.reset() fires on its own.
  document.getElementById("clear_form_button").addEventListener("click", function () {
    document.getElementById("convert_form").reset();
    updateRangeFields();
    updateTemplateDescription();
  });
</script>
</body>
</html>
